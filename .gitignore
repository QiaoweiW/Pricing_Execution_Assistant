# Temporary files
.*
!.gitignore
!.streamlit/
!.streamlit/**

# NEVER commit real Streamlit secrets — only the template is checked in.
.streamlit/secrets.toml

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# Data files (exclude sensitive data)
*.csv
*.xlsx
*.xls
*.duckdb
*.parquet
!Pricing Quote Agent/current_pricing_data.duckdb
!current_pricing_data.duckdb
!pricing_data.parquet
# Reference extracts the APP ITSELF renders — three rows each, shipped with the
# code so the guidance works on a fresh deploy.  Without this exception the
# blanket *.csv rule silently drops them and the examples vanish in production.
!example_files/**/*.csv

# Output files
Output/
*_vbcs.csv

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db*.parquet
