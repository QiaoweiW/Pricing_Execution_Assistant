# ============================================================================
# Streamlit secrets — TEMPLATE
# ----------------------------------------------------------------------------
# Copy this file to:   .streamlit/secrets.toml
# .streamlit/secrets.toml is gitignored and must NEVER be committed.
#
# On Streamlit Community Cloud, paste the same contents into
# Manage app → Settings → Secrets (NOT into the repo).
# ============================================================================

# ---------------------------------------------------------------------------
# HTST Shipment Report — Microsoft Fabric Dataflow Gen2 source
# Consumed by data_sources/htst_shipment.py from the HTST Activity Monitor.
# ---------------------------------------------------------------------------
# Auth model
# ----------
# By default the connector uses your *own* Microsoft work account via an
# interactive browser sign-in — no Azure CLI or other software install needed:
#
#   1. The first time the HTST Activity Monitor page loads, a browser window
#      pops up asking you to sign in.  Use your Darigold account.
#   2. The token is cached on disk in %LOCALAPPDATA%\.IdentityService\.
#   3. Subsequent runs reuse the cached token silently for ~90 days.
#
# That is the only step you need.  No service principal, no IT ticket,
# no admin rights.
#
# Optional service-principal escape hatch (for headless / Streamlit Cloud
# deployments) is documented at the bottom of this file.
# ---------------------------------------------------------------------------

[fabric_htst]

# Fabric workspace NAME (display name) OR workspace GUID.
# Where to find: Fabric portal → workspace home → workspace name in the
#                breadcrumb, OR Workspace settings → "Workspace ID".
# GUIDs survive workspace renames; names are friendlier.  Either works.
workspace = "<your-workspace-name>"

# Fabric Lakehouse name WITHOUT the ".Lakehouse" suffix — the connector adds it.
# Where to find: open the lakehouse in Fabric → its name appears at the top
#                of the explorer pane.
# CAPITALIZATION AND UNDERSCORES MUST MATCH EXACTLY (e.g. Pricing_Lakehouse,
# not pricing_lakehouse or Pricing Lakehouse).
lakehouse = "<your-lakehouse-name>"

# Lakehouse schema name (OPTIONAL).
# Schema-enabled lakehouses (default for fresh lakehouses created in 2025+)
# place tables under a schema namespace such as "dbo".  In the lakehouse
# explorer you'll see the table NESTED under a folder like "dbo".  If that's
# the case, set this to that folder name.  If the table appears DIRECTLY
# under "Tables" with no intermediate folder, leave this commented out.
schema = "dbo"

# Delta table name produced by the dataflow (lowercase, no spaces).
# Where to find: lakehouse explorer → Tables section → table name.
# If your dataflow writes to a different name, change this value to match.
table = "htst_shipment"


# ---------------------------------------------------------------------------
# OPTIONAL — Service principal escape hatch
# ---------------------------------------------------------------------------
# Only fill these in if your IT team has issued a service principal AND added
# it to the Fabric workspace as a Contributor.  When ALL THREE values are set,
# the connector authenticates as the SP instead of using `az login`.
#
# Leave them commented out (default) for the personal-account / az-login flow.
# ---------------------------------------------------------------------------
# tenant_id     = "00000000-0000-0000-0000-000000000000"
# client_id     = "00000000-0000-0000-0000-000000000000"
# client_secret = "REPLACE_ME_WITH_SECRET_VALUE"
